# ==========================================
# Neayouk Docker Environment Configuration
# Copy this file to .env before starting Docker Compose
# ==========================================

# ------------------------------------------
# Database Settings (PostgreSQL 18)
# ------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_this_secure_password_in_production
DB_NAME=neayoukdb

# ------------------------------------------
# Authentication (JWT)
# ------------------------------------------
JWT_SECRET=super_secret_jwt_key_please_change_in_production
JWT_EXPIRES_IN=86400

# ------------------------------------------
# API Settings
# ------------------------------------------
PORT=3000
NODE_ENV=production
# Allow requests from your static frontend domain (e.g., https://myfrontend.pages.dev or *)
CORS_ORIGIN=*

# Automated Database Migration & Seeding
RUN_MIGRATIONS=true
RUN_SEEDS=false

# ------------------------------------------
# Static Web Frontend (Option 1: Static / CDN Hosting)
# ------------------------------------------
# When building apps/web for production, set VITE_API_BASE_URL to point to your API domain:
# VITE_API_BASE_URL=https://api.yourdomain.com
# Then build: pnpm --filter @repo/contracts build && pnpm --filter web build
# Deploy apps/web/dist directly to Cloudflare Pages, Vercel, S3, or VPS host Nginx.

# ------------------------------------------
# Dozzle (Standalone Real-time Container Log Viewer)
# ------------------------------------------
DOZZLE_PORT=8080
DOZZLE_LEVEL=info

# ------------------------------------------
# Optional Observability Stack Settings
# (Connects with infra/log-explorer)
# ------------------------------------------
OBSERVABLE_ENABLE=false
LOKI_HOST=http://loki:3100
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318/v1/traces
