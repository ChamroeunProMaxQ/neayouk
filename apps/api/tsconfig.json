{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,

    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "verbatimModuleSyntax": true,
    "paths": {
      "@app/*": ["./*"]
    }
  }
}
